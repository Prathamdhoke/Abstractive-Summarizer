# Copy to .env and adjust as needed. All are optional — sensible
# defaults live in app/config.py.

# Path or Hugging Face hub id for the fine-tuned model + tokenizer.
SUMMARIZER_MODEL_NAME=./saved_summary_model

# Max characters accepted per request (pasted text or extracted file text).
SUMMARIZER_MAX_INPUT_CHARS=20000

# Max upload size in MB for /api/summarize-file.
SUMMARIZER_MAX_UPLOAD_MB=10
